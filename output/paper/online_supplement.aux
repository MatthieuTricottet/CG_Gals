\@writefile{lof}{\contentsline {figure}{\numberline {S.8}{\ignorespaces Group-adjusted CG\textsubscript  {4}{} size coefficients against the deduplicated pooled controls and each control catalogue separately. Every model uses the article's main adjustment set: stellar mass, redshift, rank, group luminosity, and velocity dispersion, with physical-group-clustered uncertainties. Bars are 95\% confidence intervals; negative values denote smaller CG\textsubscript  {4}{} effective radii at fixed covariates.}}{7}{figure.8}\protected@file@percent }
\newlabel{fig:supp_size_per_control}{{S.8}{7}{Group-adjusted \CG {} size coefficients against the deduplicated pooled controls and each control catalogue separately. Every model uses the article's main adjustment set: stellar mass, redshift, rank, group luminosity, and velocity dispersion, with physical-group-clustered uncertainties. Bars are 95\% confidence intervals; negative values denote smaller \CG {} effective radii at fixed covariates}{figure.8}{}}
