\@writefile{lof}{\contentsline {figure}{\numberline {S.1}{\ignorespaces Cumulative distributions of the sSFR residuals of (a) star-forming galaxies about the order-2 star-forming main sequence and (b) quenched galaxies about the order-4 quenched sequence, both fitted to the SDSS non-AGN reference sample. Zero marks the fitted relation; filled symbols mark the sample medians. MPA--JHU sSFRs of quenched galaxies are largely \(D_n4000\)-calibrated, so panel (b) is weakly informative.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:supp_sfms_residuals}{{S.1}{2}{Cumulative distributions of the sSFR residuals of (a) star-forming galaxies about the order-2 star-forming main sequence and (b) quenched galaxies about the order-4 quenched sequence, both fitted to the SDSS non-AGN reference sample. Zero marks the fitted relation; filled symbols mark the sample medians. MPA--JHU sSFRs of quenched galaxies are largely \(D_n4000\)-calibrated, so panel (b) is weakly informative}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S.2}{\ignorespaces Stellar-mass selection diagnostics for the exact colour-analysis retained population versus galaxies not retained, shown separately by sample. Retained counts are 110/248 for CG\textsubscript  {4}{}, 931/2792 for Control\textsubscript  {4B}{}, 1153/2812 for Control\textsubscript  {4C}{}, and 102/224 for RG\textsubscript  {4}{}. These are the same retained galaxies used by the colour analysis. Histograms are density-normalised within each retained or non-retained subset.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:supp_colour_selection}{{S.2}{2}{Stellar-mass selection diagnostics for the exact colour-analysis retained population versus galaxies not retained, shown separately by sample. Retained counts are 110/248 for \CG {}, 931/2792 for \CB {}, 1153/2812 for \CC {}, and 102/224 for \RG {}. These are the same retained galaxies used by the colour analysis. Histograms are density-normalised within each retained or non-retained subset}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S.3}{\ignorespaces Robustness of the satellite colour coefficients. Left: pooled ordinary-group comparison before and after controlling for GZ1 E/S morphology and sSFR class. Right: mass- and redshift-adjusted comparisons against each control catalogue separately. Points show the CG\textsubscript  {4}{} minus ordinary-group coefficient and bars show 95\% confidence intervals; negative values indicate bluer CG\textsubscript  {4}{} satellites.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:supp_colour_coefficients}{{S.3}{3}{Robustness of the satellite colour coefficients. Left: pooled ordinary-group comparison before and after controlling for GZ1 E/S morphology and sSFR class. Right: mass- and redshift-adjusted comparisons against each control catalogue separately. Points show the \CG {} minus ordinary-group coefficient and bars show 95\% confidence intervals; negative values indicate bluer \CG {} satellites}{figure.3}{}}
