\@writefile{lof}{\contentsline {figure}{\numberline {S.2}{\ignorespaces Stellar-mass selection diagnostics for the exact colour-analysis retained population versus galaxies not retained, shown separately by sample. Retained counts are 110/248 for CG\textsubscript  {4}{}, 931/2792 for Control\textsubscript  {4B}{}, 1153/2812 for Control\textsubscript  {4C}{}, and 102/224 for RG\textsubscript  {4}{}. These are the same retained galaxies used by the colour analysis. Histograms are density-normalised within each retained or non-retained subset.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:supp_colour_selection}{{S.2}{3}{Stellar-mass selection diagnostics for the exact colour-analysis retained population versus galaxies not retained, shown separately by sample. Retained counts are 110/248 for \CG {}, 931/2792 for \CB {}, 1153/2812 for \CC {}, and 102/224 for \RG {}. These are the same retained galaxies used by the colour analysis. Histograms are density-normalised within each retained or non-retained subset}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S.3}{\ignorespaces Robustness of the satellite colour coefficients. Left: pooled ordinary-group comparison before and after controlling for GZ1 E/S morphology and sSFR class. Right: mass- and redshift-adjusted comparisons against Control\textsubscript  {4B}{} (blue squares), Control\textsubscript  {4C}{} (amber triangles), and RG\textsubscript  {4}{} (teal diamonds). Points show the CG\textsubscript  {4}{} minus ordinary-group coefficient and bars show 95\% confidence intervals; negative values indicate bluer CG\textsubscript  {4}{} satellites.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:supp_colour_coefficients}{{S.3}{4}{Robustness of the satellite colour coefficients. Left: pooled ordinary-group comparison before and after controlling for GZ1 E/S morphology and sSFR class. Right: mass- and redshift-adjusted comparisons against \CB {} (blue squares), \CC {} (amber triangles), and \RG {} (teal diamonds). Points show the \CG {} minus ordinary-group coefficient and bars show 95\% confidence intervals; negative values indicate bluer \CG {} satellites}{figure.3}{}}
