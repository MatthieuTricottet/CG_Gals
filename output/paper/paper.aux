\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-control group-level matched satellite-composition contrasts. \(\Delta \) is the matched mean difference in elliptical-satellite fraction (CG\textsubscript  {4}{} minus control) with its 95\% pair-bootstrap interval (\(B = 9999\)); \(p_{\rm  perm}\) is the paired sign-flip permutation p-value and \(p_{\rm  Holm}\) its Holm adjustment across the three controls. Pair counts: 54 CG\textsubscript  {4}{} groups have complete matching covariates and classified satellites; against Control\textsubscript  {4B}{} and Control\textsubscript  {4C}{} (630 and 632 available control groups) every CG\textsubscript  {4}{} group finds a within-caliper partner, whereas the RG\textsubscript  {4}{} pool retains 28 pairs on common support. The pooled row (deduplicated controls) is a secondary summary.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:group_match_per_control}{{4}{6}{Per-control group-level matched satellite-composition contrasts. \(\Delta \) is the matched mean difference in elliptical-satellite fraction (\CG {} minus control) with its 95\% pair-bootstrap interval (\(B = 9999\)); \(p_{\rm perm}\) is the paired sign-flip permutation p-value and \(p_{\rm Holm}\) its Holm adjustment across the three controls. Pair counts: 54 \CG {} groups have complete matching covariates and classified satellites; against \CB {} and \CC {} (630 and 632 available control groups) every \CG {} group finds a within-caliper partner, whereas the \RG {} pool retains 28 pairs on common support. The pooled row (deduplicated controls) is a secondary summary}{table.4}{}}
