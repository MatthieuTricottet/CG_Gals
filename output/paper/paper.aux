\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Morphology and quenched fractions versus stellar mass. Columns show BGGs (left) and satellites (right) on different stellar-mass scales. The upper row shows the GZ1 E-class fraction among E/S-classified galaxies. The S-class fraction is its complement. The lower row shows the quenched fraction. All panels use mass-bin edges \(7.0, 10.0, 10.5, 11.0, 12.5\). In each bin, the samples are drawn in a fixed order around the median of their median masses, with purely visual offsets of \(\pm 0.01\) and \(\pm 0.03\)~dex. Bars give the 16th--84th percentile intervals from a bootstrap blocked by physical group, as in Fig.~\ref {fig:property_trends}. Bins with fewer than five galaxies or three physical groups are omitted (leaving only the upper two bins populated for BGGs, and excluding CG\textsubscript  {4}{} and RG\textsubscript  {4}{} from the highest-mass satellite bin).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:mass_trends}{{2}{6}{Morphology and quenched fractions versus stellar mass. Columns show BGGs (left) and satellites (right) on different stellar-mass scales. The upper row shows the GZ1 E-class fraction among E/S-classified galaxies. The S-class fraction is its complement. The lower row shows the quenched fraction. All panels use mass-bin edges \(7.0, 10.0, 10.5, 11.0, 12.5\). In each bin, the samples are drawn in a fixed order around the median of their median masses, with purely visual offsets of \(\pm 0.01\) and \(\pm 0.03\)~dex. Bars give the 16th--84th percentile intervals from a bootstrap blocked by physical group, as in Fig.~\ref {fig:property_trends}. Bins with fewer than five galaxies or three physical groups are omitted (leaving only the upper two bins populated for BGGs, and excluding \CG {} and \RG {} from the highest-mass satellite bin)}{figure.2}{}}
