\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Number of galaxies in each sSFR class for each sample. Galaxies without a valid sSFR estimate (`No sSFR') are excluded from the classification: their percentages are quoted with respect to all galaxies of the (sub)sample, while the quenched and star-forming percentages are quoted with respect to classified galaxies only. The SDSS non-AGN reference extends to substantially fainter absolute magnitudes than the CG\textsubscript  {4}{} sample and is shown for orientation only; it is not a control sample and enters no test in this paper.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:sSFR_status}{{2}{4}{Number of galaxies in each sSFR class for each sample. Galaxies without a valid sSFR estimate (`No sSFR') are excluded from the classification: their percentages are quoted with respect to all galaxies of the (sub)sample, while the quenched and star-forming percentages are quoted with respect to classified galaxies only. The SDSS non-AGN reference extends to substantially fainter absolute magnitudes than the \CG {} sample and is shown for orientation only; it is not a control sample and enters no test in this paper}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Number of galaxies in each Galaxy Zoo vote-fraction morphology class for each sample. Percentages are quoted with respect to each sample's final row count; the inferential E/S comparison conditions on the usable E/S subset. The No GZ column counts rows without finite Galaxy Zoo vote fractions after merging and is separated from the finite-vote uncertain class. As in Table~\ref {tab:sSFR_status}, the SDSS non-AGN reference is not a control sample.}}{4}{table.3}\protected@file@percent }
\newlabel{tab:morphologies}{{3}{4}{Number of galaxies in each Galaxy Zoo vote-fraction morphology class for each sample. Percentages are quoted with respect to each sample's final row count; the inferential E/S comparison conditions on the usable E/S subset. The No GZ column counts rows without finite Galaxy Zoo vote fractions after merging and is separated from the finite-vote uncertain class. As in Table~\ref {tab:sSFR_status}, the SDSS non-AGN reference is not a control sample}{table.3}{}}
