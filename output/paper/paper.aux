\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Number of galaxies in each sSFR class for each sample. Galaxies without a valid sSFR estimate (`No sSFR') are excluded from the classification: their percentages are quoted with respect to all galaxies of the (sub)sample, while the quenched and star-forming percentages are quoted with respect to classified galaxies only. The SDSS-selection row is a field-dominated reference reaching \({\sim }3\) mag fainter than any CG\textsubscript  {4}{} member, shown for orientation only; it is not a control sample and enters no test in this paper.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:sSFR_status}{{1}{4}{Number of galaxies in each sSFR class for each sample. Galaxies without a valid sSFR estimate (`No sSFR') are excluded from the classification: their percentages are quoted with respect to all galaxies of the (sub)sample, while the quenched and star-forming percentages are quoted with respect to classified galaxies only. The SDSS-selection row is a field-dominated reference reaching \({\sim }3\) mag fainter than any \CG {} member, shown for orientation only; it is not a control sample and enters no test in this paper}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Number of galaxies in each Galaxy Zoo vote-fraction morphology proxy for each sample. As in Table~\ref {tab:sSFR_status}, the SDSS-selection row is a field-dominated reference reaching \({\sim }3\) mag fainter than any CG\textsubscript  {4}{} member, not a control sample.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:morphologies}{{2}{4}{Number of galaxies in each Galaxy Zoo vote-fraction morphology proxy for each sample. As in Table~\ref {tab:sSFR_status}, the SDSS-selection row is a field-dominated reference reaching \({\sim }3\) mag fainter than any \CG {} member, not a control sample}{table.2}{}}
