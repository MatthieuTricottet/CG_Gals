\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Morphology and quenched fractions versus stellar mass. Top: fraction of galaxies classified elliptical (a) and spiral (b) among usable Galaxy Zoo classifications (filled symbols) and mean debiased elliptical and spiral vote fractions over all galaxies with finite votes (open symbols, offset slightly in mass). Bottom: quenched fractions among valid-sSFR satellites (c) and BGGs (d). All samples use the same bins within each row: edges \(7.0, 9.5, 10.0, 10.5, 11.0, 12.5\) for morphology and \(7.0, 10.0, 10.5, 11.0, 12.5\) for quenching. Each estimate is plotted at the median stellar mass of the contributing galaxies; points are not connected because the bins have unequal widths. Bars are 16th--84th percentile physical-group-blocked bootstrap intervals of the filled symbols; bins with fewer than five galaxies or three groups are omitted.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:mass_trends}{{2}{5}{Morphology and quenched fractions versus stellar mass. Top: fraction of galaxies classified elliptical (a) and spiral (b) among usable Galaxy Zoo classifications (filled symbols) and mean debiased elliptical and spiral vote fractions over all galaxies with finite votes (open symbols, offset slightly in mass). Bottom: quenched fractions among valid-sSFR satellites (c) and BGGs (d). All samples use the same bins within each row: edges \(7.0, 9.5, 10.0, 10.5, 11.0, 12.5\) for morphology and \(7.0, 10.0, 10.5, 11.0, 12.5\) for quenching. Each estimate is plotted at the median stellar mass of the contributing galaxies; points are not connected because the bins have unequal widths. Bars are 16th--84th percentile physical-group-blocked bootstrap intervals of the filled symbols; bins with fewer than five galaxies or three groups are omitted}{figure.2}{}}
\@LN@col{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Adjusted CG\textsubscript  {4}{} odds ratios from the three separate per-control contrasts (colour-coded as in Fig.~\ref {fig:mass_trends}) for the all-galaxy elliptical and quenched outcomes. Bars show 95\% confidence intervals; the vertical line marks equal odds.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:primary_contrasts}{{3}{5}{Adjusted \CG {} odds ratios from the three separate per-control contrasts (colour-coded as in Fig.~\ref {fig:mass_trends}) for the all-galaxy elliptical and quenched outcomes. Bars show 95\% confidence intervals; the vertical line marks equal odds}{figure.3}{}}
