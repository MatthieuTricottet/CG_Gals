\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Sample definitions on the sky. (a) All 14 members of Lim group 1117, which hosts the embedded compact group CG\textsubscript  {4}{}~204 (\(z = 0.037\), close to the CG\textsubscript  {4}{} median of 0.037), in projected proper kpc relative to the host BGG; symbol area scales with $r$-band luminosity. The compact-group members (black circles), the would-be Control\textsubscript  {4B}{} quartet (the BGG and its three brightest members within 3 mag; blue squares) and the would-be Control\textsubscript  {4C}{} quartet (the BGG and its three nearest projected members within 3 mag; orange triangles) are marked. Because this host contains CG\textsubscript  {4}{} galaxies it is excluded from the actual control samples. (b) The RG\textsubscript  {4}{} group 10914 (\(z = 0.037\)) on the same scale.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:schematic}{{1}{3}{Sample definitions on the sky. (a) All 14 members of Lim group 1117, which hosts the embedded compact group \CG {}~204 (\(z = 0.037\), close to the \CG {} median of 0.037), in projected proper kpc relative to the host BGG; symbol area scales with $r$-band luminosity. The compact-group members (black circles), the would-be \CB {} quartet (the BGG and its three brightest members within 3 mag; blue squares) and the would-be \CC {} quartet (the BGG and its three nearest projected members within 3 mag; orange triangles) are marked. Because this host contains \CG {} galaxies it is excluded from the actual control samples. (b) The \RG {} group 10914 (\(z = 0.037\)) on the same scale}{figure.1}{}}
